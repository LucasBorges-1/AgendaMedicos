# Adapte root, server_name e o socket do PHP-FPM à sua instalação.
server {
    listen 80;
    server_name agenda.exemplo.com;
    root /var/www/AgendaVidas;
    index index.php;
    client_max_body_size 64k;

    location ~ /\. { deny all; }
    location ~ ^/(app|bin|database|tests|deploy)(/|$) { deny all; }
    location ~ ^/(conexao\.php|router\.php|Dockerfile|compose\.yaml|README\.md)$ { deny all; }
    location / { try_files $uri $uri/ =404; }
    location ~ \.php$ {
        try_files $uri =404;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_pass unix:/run/php/php8.3-fpm.sock;
    }
}
