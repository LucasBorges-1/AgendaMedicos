{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["gru1"],
  "functions": {
    "api/vercel.php": {
      "runtime": "vercel-php@0.9.0",
      "includeFiles": "{app/**,index.php,login.php,medicos.php,usuarios.php,imprimir.php,pdf.php,api/index.php}",
      "excludeFiles": "{.env*,tests/**,database/**,bin/**,deploy/**}",
      "maxDuration": 30
    }
  },
  "routes": [
    {"src": "/(css|js|img)/([a-zA-Z0-9_-]+\\.(?:css|js|png|jpg|svg|ico|webp))", "dest": "/$1/$2", "headers": {"Cache-Control": "public, max-age=3600"}},
    {"src": "/(.*)", "dest": "/api/vercel.php", "headers": {"Cache-Control": "private, no-store"}}
  ]
}
